# Copie para .env. Nunca compartilhe o arquivo .env nem faça commit de senhas.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_AQUI
# APENAS no servidor Node! NUNCA adicione esta chave ao front-end.
# Use a chave secreta do projeto (ou service_role legada).
SUPABASE_SECRET_KEY=sb_secret_SEU_SEGREDO_AQUI
PORT=3333
# URL do front que vai chamar a API futuramente. Para vários, separar por vírgulas.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Em produção atrás de um proxy confiável, configure conforme o provedor.
TRUST_PROXY=false
# Em homologação: evita que buscadores indexem a demonstração (não é autenticação).
APP_NO_INDEX=true
# NODE_ENV=production no Railway; não é necessário configurar PORT lá.
